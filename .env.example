# Clinexa Environment Configuration
#
# Copy this file to .env and fill in your values before running docker-compose
#

# ============================================================================
# DOCKER PROFILES
# ============================================================================
COMPOSE_PROFILES=kafka,postgres,mongo,redis,zipkin

# ============================================================================
# INFRASTRUCTURE
# ============================================================================

# =============== KAFKA ===============
# IMPORTANT: This ID is critical for Kafka cluster initialization
KAFKA_CLUSTER_ID=zzY-gSWaQOCQXvkdiLgDmw
KAFKA_BROKER=kafka:9092

# =============== POSTGRES ===============
# POSTGRES_HOST is for consuming services (not docker-compose.yaml itself) to reach the postgres container by its service name
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=clinexa
POSTGRES_PASSWORD=clinexa

# =============== MONGO ===============
# MONGO_HOST is for consuming services (not docker-compose.yaml itself) to reach the mongo container by its service name
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=clinexa
MONGO_PASSWORD=clinexa

# =============== MONGO EXPRESS ===============
# Web UI for MongoDB, shares the `mongo` profile
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=clinexa
MONGO_EXPRESS_PASSWORD=clinexa

# =============== REDIS ===============
# REDIS_HOST is for consuming services (not docker-compose.yaml itself) to reach the redis container by its service name
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=clinexa

# =============== REDISINSIGHT ===============
# Web UI for Redis, shares the `redis` profile — connects using REDIS_PASSWORD above
REDISINSIGHT_PORT=5540

# =============== ZIPKIN ===============
# ZIPKIN_HOST is for consuming services (not docker-compose.yaml itself) to reach the zipkin container by its service name
ZIPKIN_HOST=zipkin
ZIPKIN_PORT=9411

# =============== MAIL-DEV ===============
# MAILDEV_HOST is for consuming services (not docker-compose.yaml itself) to reach the mail-dev container by its service name
MAILDEV_HOST=mail-dev
MAILDEV_SMTP_PORT=1025
MAILDEV_UI_PORT=1080
