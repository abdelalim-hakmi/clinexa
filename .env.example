# Clinexa Environment Configuration
#
# Copy this file to .env and fill in your values before running docker-compose
#

# ============================================================================
# DOCKER PROFILES
# ============================================================================
COMPOSE_PROFILES=kafka,postgres,mongo

# ============================================================================
# INFRASTRUCTURE
# ============================================================================

# =============== KAFKA ===============
# IMPORTANT: This ID is critical for Kafka cluster initialization
KAFKA_CLUSTER_ID=zzY-gSWaQOCQXvkdiLgDmw
KAFKA_BROKER=kafka:9092


# =============== POSTGRES ===============
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_USER=
# POSTGRES_PASSWORD=

